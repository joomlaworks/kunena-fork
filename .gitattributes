# Normalise line endings
* text=auto eol=lf
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary

# Development files left out of the archive GitHub exports ("Download ZIP"),
# which is installable as-is in Joomla's Extension Manager.
/.php-cs-fixer.dist.php export-ignore
/.gitattributes        export-ignore
/.gitignore            export-ignore
/AGENTS.md             export-ignore
/JS-MIGRATION.md       export-ignore
/tests                 export-ignore
