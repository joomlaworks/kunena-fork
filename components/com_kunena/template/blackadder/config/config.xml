<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!DOCTYPE config>
<config>
    <fieldset name="COM_KUNENA_TEMPLATE_TAB_ADVANCED">
        <field name="tooltips" type="list" default="0" label="COM_KUNENA_TEMPLATE_LOAD_TOOLTIPS" description="COM_KUNENA_TEMPLATE_LOAD_TOOLTIPS_DESC">
            <option value="0">COM_KUNENA_NO</option>
            <option value="1">COM_KUNENA_YES</option>
        </field>
        <field name="SubjectLengthMessage" type="text" default="80" label="COM_KUNENA_TEMPLATE_SUBJECT_LENGTH_MESSAGE_LENGTH" description="COM_KUNENA_TEMPLATE_SUBJECT_LENGTH_MESSAGE_LENGTH_DESC"/>
        <field name="quick" type="list" default="2" label="COM_KUNENA_TEMPLATE_QUICKREPLY" description="COM_KUNENA_TEMPLATE_QUICKREPLY_DESC">
            <option value="0">COM_KUNENA_TEMPLATE_DEFAULT</option>
            <option value="1">COM_KUNENA_TEMPLATE_QUICKREPLY_MODAL</option>
            <option value="2">COM_KUNENA_TEMPLATE_QUICKREPLY_ALWAYS</option>
        </field>
    </fieldset>

    <fieldset name="COM_KUNENA_TEMPLATE_TAB_FEATURES">
        <field name="displayMenu" type="list" default="1" label="COM_KUNENA_TEMPLATE_DISPLAY_MENU" description="COM_KUNENA_TEMPLATE_DISPLAY_MENU_DESC">
            <option value="0">COM_KUNENA_NO</option>
            <option value="1">COM_KUNENA_YES</option>
        </field>
        <field name="displayDropdownMenu" type="list" default="1" label="COM_KUNENA_TEMPLATE_DISPLAY_DROPDOWNMENU" description="COM_KUNENA_TEMPLATE_DISPLAY_DROPDOWNMENU_DESC">
            <option value="0">COM_KUNENA_NO</option>
            <option value="1">COM_KUNENA_YES</option>
        </field>
        <field name="displayDropdownContent" type="list" default="1" label="COM_KUNENA_TEMPLATE_DISPLAY_DROPDOWNCONTENT" description="COM_KUNENA_TEMPLATE_DISPLAY_DROPDOWNCONTENT_DESC">
            <option value="0">COM_KUNENA_NO</option>
            <option value="1">COM_KUNENA_YES</option>
        </field>
        <field name="displayModule" type="list" default="1" label="COM_KUNENA_TEMPLATE_DISPLAY_MODULE" description="COM_KUNENA_TEMPLATE_DISPLAY_MODULE_DESC">
            <option value="0">COM_KUNENA_NO</option>
            <option value="1">COM_KUNENA_YES</option>
        </field>
        <field name="displayBreadcrumb" type="list" default="1" label="COM_KUNENA_TEMPLATE_DISPLAY_BREADCRUMB" description="COM_KUNENA_TEMPLATE_DISPLAY_BREADCRUMB_DESC">
            <option value="0">COM_KUNENA_NO</option>
            <option value="1">COM_KUNENA_YES</option>
        </field>
        <field name="displayAnnouncement" type="list" default="1" label="COM_KUNENA_TEMPLATE_DISPLAY_ANNOUNCEMENT" description="COM_KUNENA_TEMPLATE_DISPLAY_ANNOUNCEMENT_DESC">
            <option value="0">COM_KUNENA_NO</option>
            <option value="1">COM_KUNENA_YES</option>
        </field>
        <field name="displayFooter" type="list" default="1" label="COM_KUNENA_TEMPLATE_DISPLAY_FOOTER" description="COM_KUNENA_TEMPLATE_DISPLAY_FOOTER_DESC">
            <option value="0">COM_KUNENA_NO</option>
            <option value="1">COM_KUNENA_YES</option>
        </field>
        <field name="avatarType" type="list" default="img-circle" label="COM_KUNENA_TEMPLATE_PROFILE_TYPE" description="COM_KUNENA_TEMPLATE_PROFILE_TYPE_DESC">
            <option value="img-rounded">COM_KUNENA_TEMPLATE_ROUNDED</option>
            <option value="img-circle">COM_KUNENA_TEMPLATE_CIRCLE</option>
            <option value="img-polaroid">COM_KUNENA_TEMPLATE_THUMBNAIL</option>
            <option value="none">COM_KUNENA_TEMPLATE_NONE</option>
        </field>
        <field name="labels" type="list" default="0" label="COM_KUNENA_TEMPLATE_LABELS" description="COM_KUNENA_TEMPLATE_LABELS_DESC">
            <option value="0">COM_KUNENA_DISABLED</option>
            <option value="1">COM_KUNENA_ENABLED_TOPIC</option>
            <option value="2">COM_KUNENA_ENABLED_LABEL</option>
        </field>
        <field name="whoisonlineName" type="list" default="default" label="COM_KUNENA_TEMPLATE_WHOISONLINE_NAME" description="COM_KUNENA_TEMPLATE_WHOISONLINE_NAME_DESC">
            <option value="default">COM_KUNENA_TEMPLATE_WHOISONLINE_NAME_NAME</option>
            <option value="avatar">COM_KUNENA_TEMPLATE_WHOISONLINE_NAME_AVATAR</option>
            <option value="both">COM_KUNENA_TEMPLATE_WHOISONLINE_NAME_BOTH</option>
        </field>
        <field name="formRecover" type="list" default="0" label="COM_KUNENA_TEMPLATE_RECOVER" description="COM_KUNENA_TEMPLATE_RECOVER_DESC">
            <option value="0">COM_KUNENA_NO</option>
            <option value="1">COM_KUNENA_YES</option>
        </field>
        <field name="socialshare" type="list" default="0" label="COM_KUNENA_TEMPLATE_DISPLAY_SOCIALSHARE" description="COM_KUNENA_TEMPLATE_DISPLAY_SOCIALSHARE_DESC">
            <option value="0">COM_KUNENA_NO</option>
            <option value="1">COM_KUNENA_YES</option>
            <option value="2">COM_KUNENA_TEMPLATE_TAG</option>
        </field>
        <field name="socialsharetag" type="text" default="" label="COM_KUNENA_TEMPLATE_DISPLAY_SOCIALSHARETAG" description="COM_KUNENA_TEMPLATE_DISPLAY_SOCIALSHARETAG_DESC"/>
        <field name="socialtheme" type="list" default="classic" label="COM_KUNENA_TEMPLATE_DISPLAY_SOCIALTHEME" description="COM_KUNENA_TEMPLATE_DISPLAY_SOCIALTHEME_DESC">
            <option value="classic">COM_KUNENA_CLASSIC</option>
            <option value="flat">COM_KUNENA_FLAT</option>
            <option value="minima">COM_KUNENA_MINIMA</option>
            <option value="plain">COM_KUNENA_PLAIN</option>
        </field>
        <field name="optional_username" type="list" default="0" label="COM_KUNENA_TEMPLATE_DISPLAY_OPTIONAL_USERNAME" description="COM_KUNENA_TEMPLATE_DISPLAY_OPTIONAL_USERNAME_DESC">
            <option value="0">COM_KUNENA_NO</option>
            <option value="1">COM_KUNENA_USERNAME</option>
            <option value="2">COM_KUNENA_REALNAME</option>
        </field>
        <field name="writeaccess" type="list" default="0" label="COM_KUNENA_TEMPLATE_DISPLAY_WRITEACCESS" description="COM_KUNENA_TEMPLATE_DISPLAY_WRITEACCESS_DESC">
            <option value="0">COM_KUNENA_NO</option>
            <option value="1">COM_KUNENA_YES</option>
        </field>
        <field name="localstorage" type="list" default="0" label="COM_KUNENA_TEMPLATE_LOCALSTORAGE" description="COM_KUNENA_TEMPLATE_LOCALSTORAGE_DESC">
            <option value="0">COM_KUNENA_NO</option>
            <option value="1">COM_KUNENA_YES</option>
        </field>
    </fieldset>

    <fieldset name="COM_KUNENA_TEMPLATE_TAB_AVATAR">
        <field name="avatarSizeX" label="COM_KUNENA_TEMPLATE_AVATAR_SIZE_X_LABEL" description="COM_KUNENA_TEMPLATE_AVATAR_SIZE_X_DESC" default="40"/>
        <field name="avatarSizeY" label="COM_KUNENA_TEMPLATE_AVATAR_SIZE_Y_LABEL" description="COM_KUNENA_TEMPLATE_AVATAR_SIZE_Y_DESC" default="90"/>
        <!-- Required avatar sizes -->
        <field name="avatarSizeXThumb" label="COM_KUNENA_TEMPLATE_AVATAR_SIZE_X_THUMB_LABEL" description="COM_KUNENA_TEMPLATE_AVATAR_SIZE_X_THUMB_DESC" default="36"/>
        <field name="avatarSizeYThumb" label="COM_KUNENA_TEMPLATE_AVATAR_SIZE_Y_THUMB_LABEL" description="COM_KUNENA_TEMPLATE_AVATAR_SIZE_Y_THUMB_DESC" default="36"/>
        <field name="avatarSizeXWelcome" label="COM_KUNENA_TEMPLATE_AVATAR_SIZE_X_WELCOME_LABEL" description="COM_KUNENA_TEMPLATE_AVATAR_SIZE_X_WELCOME_DESC" default="72"/>
        <field name="avatarSizeYWelcome" label="COM_KUNENA_TEMPLATE_AVATAR_SIZE_Y_WELCOME_LABEL" description="COM_KUNENA_TEMPLATE_AVATAR_SIZE_Y_WELCOME_DESC" default="72"/>
        <field name="avatarSizeXList" label="COM_KUNENA_TEMPLATE_AVATAR_SIZE_X_LIST_LABEL" description="COM_KUNENA_TEMPLATE_AVATAR_SIZE_X_LIST_DESC" default="36"/>
        <field name="avatarSizeYList" label="COM_KUNENA_TEMPLATE_AVATAR_SIZE_Y_LIST_LABEL" description="COM_KUNENA_TEMPLATE_AVATAR_SIZE_Y_LIST_DESC" default="36"/>
        <field name="avatarSizeXPost" label="COM_KUNENA_TEMPLATE_AVATAR_SIZE_X_POST_LABEL" description="COM_KUNENA_TEMPLATE_AVATAR_SIZE_X_POST_DESC" default="144"/>
        <field name="avatarSizeYPost" label="COM_KUNENA_TEMPLATE_AVATAR_SIZE_Y_POST_LABEL" description="COM_KUNENA_TEMPLATE_AVATAR_SIZE_Y_POST_DESC" default="144"/>
        <field name="avatarSizeXProfile" label="COM_KUNENA_TEMPLATE_AVATAR_SIZE_X_PROFILE_LABEL" description="COM_KUNENA_TEMPLATE_AVATAR_SIZE_X_PROFILE_DESC" default="200"/>
        <field name="avatarSizeYProfile" label="COM_KUNENA_TEMPLATE_AVATAR_SIZE_Y_PROFILE_LABEL" description="COM_KUNENA_TEMPLATE_AVATAR_SIZE_Y_PROFILE_DESC" default="200"/>
    </fieldset>

    <fieldset name="template">
        <field name="templatebyText" label="COM_KUNENA_TEMPLATE_AVATAR_TEXT_LABEL" description="COM_KUNENA_TEMPLATE_AVATAR_TEXT_DESC" default=""/>
        <field name="templatebyName" label="COM_KUNENA_TEMPLATE_AVATAR_NAME_LABEL" description="COM_KUNENA_TEMPLATE_AVATAR_TEXT_DESC" default=""/>
        <field name="templatebyLink" label="COM_KUNENA_TEMPLATE_AVATAR_LINK_LABEL" description="COM_KUNENA_TEMPLATE_AVATAR_TEXT_DESC" default=""/>
    </fieldset>
</config>
